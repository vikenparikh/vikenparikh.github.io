---
import { siteConfig } from "../config";
import { getCollection } from "astro:content";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasSkills = siteConfig.skills && siteConfig.skills.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
// Show the Writing link only once a real (non-draft) post exists, so the section
// stays hidden until there's something to read.
const hasWriting = (await getCollection("writing", ({ data }) => !data.draft)).length > 0;
---



<header id="header" class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-200 shadow-sm px-4 py-3 flex items-center justify-between">
  <div class="flex items-center gap-3">
      {/* Decorative avatar — the adjacent name span already labels this link, so
          empty alt avoids a screen reader announcing the name twice (axe
          image-redundant-alt). */}
      <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="header-profile flex items-center gap-3">
        {siteConfig.profileImage && (
          <img
            src={siteConfig.profileImage}
            alt=""
            width="40"
            height="40"
            decoding="async"
            class="h-10 w-10 rounded-full border border-gray-300 object-cover"
          />
        )}
        <span class="text-lg font-bold text-gray-900">{siteConfig.name}</span>
      </a>
  </div>
  <nav aria-label="Primary" class="hidden md:flex flex-1 justify-center">
    <ul class="flex items-center gap-6">
      <li><a href="/#about" class="text-gray-700 hover:text-black font-medium transition-colors">About</a></li>
      {hasSkills && (<li><a href="/#skills" class="text-gray-700 hover:text-black font-medium transition-colors">Skills</a></li>)}
      {hasExperience && (<li><a href="/#experience" class="text-gray-700 hover:text-black font-medium transition-colors">Experience</a></li>)}
      {hasEducation && (<li><a href="/#education" class="text-gray-700 hover:text-black font-medium transition-colors">Education</a></li>)}
      {hasProjects && (<li><a href="/#projects" class="text-gray-700 hover:text-black font-medium transition-colors">Projects</a></li>)}
      {hasWriting && (<li><a href="/writing" class="text-gray-700 hover:text-black font-medium transition-colors">Writing</a></li>)}
    </ul>
  </nav>
  <div class="flex items-center gap-2">
    {siteConfig.resumeUrl && (
      <a
        href={siteConfig.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center rounded-full bg-gray-900 px-4 py-1.5 text-sm font-semibold text-white transition-colors duration-300 hover:bg-gray-700"
      >
        View Resume
      </a>
    )}
    <a
      href={siteConfig.calendarUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center rounded-full border border-blue-600 bg-white px-4 py-1.5 text-sm font-semibold text-blue-700 transition-colors duration-300 hover:bg-blue-50 hover:border-blue-800"
    >
      Book 15 min chat
    </a>
    <button class="md:hidden ml-2 p-2 rounded bg-gray-100 hover:bg-gray-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-1" aria-label="Open navigation" aria-controls="mobile-nav" aria-expanded="false" onclick="const n=document.getElementById('mobile-nav');const open=n.classList.toggle('hidden')===false;this.setAttribute('aria-expanded', String(open));">
      <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <nav id="mobile-nav" aria-label="Mobile" class="md:hidden fixed top-16 left-0 w-full bg-white border-t border-gray-200 shadow-lg hidden z-50">
    <ul class="flex flex-col items-center gap-4 py-4">
      <li><a href="/#about" class="text-gray-700 hover:text-black font-medium transition-colors">About</a></li>
      {hasSkills && (<li><a href="/#skills" class="text-gray-700 hover:text-black font-medium transition-colors">Skills</a></li>)}
      {hasExperience && (<li><a href="/#experience" class="text-gray-700 hover:text-black font-medium transition-colors">Experience</a></li>)}
      {hasEducation && (<li><a href="/#education" class="text-gray-700 hover:text-black font-medium transition-colors">Education</a></li>)}
      {hasProjects && (<li><a href="/#projects" class="text-gray-700 hover:text-black font-medium transition-colors">Projects</a></li>)}
      {hasWriting && (<li><a href="/writing" class="text-gray-700 hover:text-black font-medium transition-colors">Writing</a></li>)}
    </ul>
  </nav>
</header>
<style>
    @media (max-width: 768px) {
      #header {
        flex-direction: row;
        padding: 0.75rem 0.5rem;
      }
      #header nav ul {
        gap: 1rem;
      }
      #header img {
        height: 2rem;
        width: 2rem;
      }
      #header span {
        font-size: 1rem;
      }
    }
  </style>

<script>
  window.addEventListener("scroll", () => {
    const header = document.getElementById("header");
    if (window.scrollY > 100) {
      header?.classList.add("bg-white/80", "backdrop-blur-sm");
    } else {
      header?.classList.remove("bg-white/80", "backdrop-blur-sm");
    }
  });

  // Close the mobile menu after a link is tapped (it's a full-width fixed
  // overlay — otherwise it stays open covering the page) and on Escape.
  const mobileNav = document.getElementById("mobile-nav");
  const mobileBtn = document.querySelector('[aria-controls="mobile-nav"]');
  const closeMobileNav = () => {
    mobileNav?.classList.add("hidden");
    mobileBtn?.setAttribute("aria-expanded", "false");
  };
  mobileNav?.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMobileNav));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMobileNav();
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
