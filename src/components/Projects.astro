---
import { siteConfig } from "../config";
---

<section id="projects" class="p-8 sm:p-12 md:p-16 lg:p-24">
    <div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-4">
          <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-7xl font-bold text-gray-900 dark:text-gray-100">Projects</h2>
          <div class="w-[75px] h-[5px] mt-2 rounded-full" style={`background-color: ${siteConfig.accentColor}`} />
        </div>
        <div class="lg:col-span-8">
          <div class="space-y-8">
            <h3 class="text-xl font-semibold text-blue-700 dark:text-blue-400 mb-6">Featured AI Projects</h3>
            <div class="space-y-6">
              {/* Featured Projects Block — the three production AI products shipped end-to-end */}
              <div class="group bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col gap-3 border border-transparent transition-all duration-300 hover:shadow-lg hover:border-blue-200">
                <div class="flex items-center gap-2">
                  <a href="https://github.com/vikenparikh/edumind-ai" target="_blank" rel="noopener noreferrer" class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-blue-700 transition-colors">edumind-ai</a>
                  <a href="https://github.com/vikenparikh/edumind-ai" target="_blank" rel="noopener noreferrer" aria-label="edumind-ai on GitHub" class="ml-1">
                    <img src="/images/github-mark.svg" alt="GitHub" width="20" height="20" class="w-5 h-5 inline" />
                  </a>
                </div>
                <p class="text-gray-700 dark:text-gray-300">Adaptive learning platform that personalizes content per student and surfaces analytics for educators — retrieval-grounded LLM tutoring with eval-gated responses.</p>
                <div class="flex flex-wrap gap-2 mt-1">
                  <span class="px-2 py-1 text-xs rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400">LLM Agents</span>
                  <span class="px-2 py-1 text-xs rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400">RAG</span>
                  <span class="px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">FastAPI</span>
                  <span class="px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Python</span>
                </div>
              </div>
              <div class="group bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col gap-3 border border-transparent transition-all duration-300 hover:shadow-lg hover:border-blue-200">
                <div class="flex items-center gap-2">
                  <a href="https://github.com/vikenparikh/neuralverse-ai" target="_blank" rel="noopener noreferrer" class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-blue-700 transition-colors">neuralverse-ai</a>
                  <a href="https://github.com/vikenparikh/neuralverse-ai" target="_blank" rel="noopener noreferrer" aria-label="neuralverse-ai on GitHub" class="ml-1">
                    <img src="/images/github-mark.svg" alt="GitHub" width="20" height="20" class="w-5 h-5 inline" />
                  </a>
                </div>
                <p class="text-gray-700 dark:text-gray-300">Unified multi-agent development platform: supervisor/worker orchestration over LangGraph + MCP, with knowledge-graph-backed memory and structured tool use.</p>
                <div class="flex flex-wrap gap-2 mt-1">
                  <span class="px-2 py-1 text-xs rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400">Multi-Agent</span>
                  <span class="px-2 py-1 text-xs rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400">LangGraph</span>
                  <span class="px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Knowledge Graphs</span>
                  <span class="px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Python</span>
                </div>
              </div>
              <div class="group bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col gap-3 border border-transparent transition-all duration-300 hover:shadow-lg hover:border-blue-200">
                <div class="flex items-center gap-2">
                  <a href="https://github.com/vikenparikh/medmind-ai" target="_blank" rel="noopener noreferrer" class="text-lg font-bold text-gray-900 dark:text-gray-100 group-hover:text-blue-700 transition-colors">medmind-ai</a>
                  <a href="https://github.com/vikenparikh/medmind-ai" target="_blank" rel="noopener noreferrer" aria-label="medmind-ai on GitHub" class="ml-1">
                    <img src="/images/github-mark.svg" alt="GitHub" width="20" height="20" class="w-5 h-5 inline" />
                  </a>
                </div>
                <p class="text-gray-700 dark:text-gray-300">Clinical decision-support system with retrieval-augmented reasoning over medical corpora, structured outputs, and safety guardrails for grounded, citable answers.</p>
                <div class="flex flex-wrap gap-2 mt-1">
                  <span class="px-2 py-1 text-xs rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400">RAG</span>
                  <span class="px-2 py-1 text-xs rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400">Guardrails</span>
                  <span class="px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">pgvector</span>
                  <span class="px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Python</span>
                </div>
              </div>
            </div>
            <h3 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-6 mt-12">Other Projects</h3>
            <div class="space-y-6">
              <div class="group bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col gap-2 border border-transparent transition-all duration-300 hover:shadow-lg hover:border-blue-200">
                <div class="flex items-center gap-2">
                  <span class="text-lg font-bold text-gray-900 dark:text-gray-100">AWS-AutoScaling-Object-Detection</span>
                  <span class="ml-2 px-2 py-1 text-xs rounded bg-yellow-100 dark:bg-yellow-900/40 text-yellow-700 dark:text-yellow-300">AWS</span>
                  <span class="px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Java</span>
                </div>
                <div class="text-gray-700 dark:text-gray-300">Cloud platform for scalable object detection using YOLO and AWS services.</div>
              </div>
              <div class="group bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col gap-2 border border-transparent transition-all duration-300 hover:shadow-lg hover:border-blue-200">
                <div class="flex items-center gap-2">
                  <a href="https://github.com/vikenparikh/investiq-ai" target="_blank" rel="noopener noreferrer" class="text-lg font-bold text-gray-900 dark:text-gray-100 hover:text-blue-700">investiq-ai</a>
                  <a href="https://github.com/vikenparikh/investiq-ai" target="_blank" rel="noopener noreferrer" class="ml-1">
                    <img src="/images/github-mark.svg" alt="GitHub" width="20" height="20" class="w-5 h-5 inline" />
                  </a>
                  <span class="ml-2 px-2 py-1 text-xs rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400">AI</span>
                  <span class="px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Python</span>
                </div>
                <div class="text-gray-700 dark:text-gray-300">AI-driven financial intelligence platform with portfolio optimization and risk analysis.</div>
              </div>
              <div class="group bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col gap-2 border border-transparent transition-all duration-300 hover:shadow-lg hover:border-blue-200">
                <div class="flex items-center gap-2">
                  <span class="text-lg font-bold text-gray-900 dark:text-gray-100">Mutext</span>
                  <span class="ml-2 px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Python</span>
                </div>
                <div class="text-gray-700 dark:text-gray-300">Music and text generation using deep learning models.</div>
              </div>
              <div class="group bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col gap-2 border border-transparent transition-all duration-300 hover:shadow-lg hover:border-blue-200">
                <div class="flex items-center gap-2">
                  <span class="text-lg font-bold text-gray-900 dark:text-gray-100">PhoCaptionator</span>
                  <span class="ml-2 px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Python</span>
                </div>
                <div class="text-gray-700 dark:text-gray-300">Photo captioning application powered by neural networks.</div>
              </div>
              <div class="group bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col gap-2 border border-transparent transition-all duration-300 hover:shadow-lg hover:border-blue-200">
                <div class="flex items-center gap-2">
                  <span class="text-lg font-bold text-gray-900 dark:text-gray-100">LeVoyage</span>
                  <span class="ml-2 px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Backend</span>
                  <span class="px-2 py-1 text-xs rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400">AI</span>
                </div>
                <div class="text-gray-700 dark:text-gray-300">Website about various travel places in India with backend AI features.</div>
              </div>
              <div class="group bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col gap-2 border border-transparent transition-all duration-300 hover:shadow-lg hover:border-blue-200">
                <div class="flex items-center gap-2">
                  <span class="text-lg font-bold text-gray-900 dark:text-gray-100">Vetflix</span>
                  <span class="ml-2 px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Backend</span>
                  <span class="px-2 py-1 text-xs rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400">AI</span>
                </div>
                <div class="text-gray-700 dark:text-gray-300">Movies and TV shows recommendation engine with backend AI.</div>
              </div>
              <div class="group bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col gap-2 border border-transparent transition-all duration-300 hover:shadow-lg hover:border-blue-200">
                <div class="flex items-center gap-2">
                  <span class="text-lg font-bold text-gray-900 dark:text-gray-100">Travigate-Front-End</span>
                  <span class="ml-2 px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Backend</span>
                  <span class="px-2 py-1 text-xs rounded bg-blue-100 dark:bg-blue-900/40 text-blue-700 dark:text-blue-400">AI</span>
                </div>
                <div class="text-gray-700 dark:text-gray-300">Personal travel app with ML-powered recommendations and sentiment analysis.</div>
              </div>
              <div class="group bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col gap-2 border border-transparent transition-all duration-300 hover:shadow-lg hover:border-blue-200">
                <div class="flex items-center gap-2">
                  <span class="text-lg font-bold text-gray-900 dark:text-gray-100">Food-Donation-System</span>
                  <span class="ml-2 px-2 py-1 text-xs rounded bg-green-100 dark:bg-green-900/40 text-green-700 dark:text-green-300">Frontend</span>
                </div>
                <div class="text-gray-700 dark:text-gray-300">Portal connecting donors with NGOs to reduce food waste.</div>
              </div>
              <div class="group bg-white dark:bg-gray-800 rounded-lg shadow p-6 flex flex-col gap-2 border border-transparent transition-all duration-300 hover:shadow-lg hover:border-blue-200">
                <div class="flex items-center gap-2">
                  <span class="text-lg font-bold text-gray-900 dark:text-gray-100">House-Prices-Prediction</span>
                  <span class="ml-2 px-2 py-1 text-xs rounded bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">Python</span>
                </div>
                <div class="text-gray-700 dark:text-gray-300">Prediction of house prices based on various attributes.</div>
              </div>
            </div>
            <p class="mt-8 text-center text-lg">View all projects and source code on <a href="https://github.com/vikenparikh" target="_blank" rel="noopener noreferrer" class="text-blue-700 dark:text-blue-400 underline">github.com/vikenparikh</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>
